--Single Column
SELECT *
FROM employees
WHERE department IN ('IT', 'HR');

--Numeric Values
SELECT *
FROM employees
WHERE salary IN (40000, 55000);

--Using NOT IN
SELECT *
FROM employees
WHERE department NOT IN ('IT', 'HR');

--Using IN with a Subquery
SELECT *
FROM employees
WHERE department IN (
    SELECT department
    FROM employees
    WHERE salary > 50000
);
